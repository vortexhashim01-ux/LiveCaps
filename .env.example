# ============================================================
# LiveCaps - environment settings
# ------------------------------------------------------------
# Copy this file to `.env` and fill in only what you need.
# Everything below works with the defaults, so an empty `.env`
# is a valid setup.
#
# IMPORTANT: every VITE_ variable is baked into the browser
# bundle and is publicly visible. Never put private keys here.
# ============================================================

# ---- Core (no key needed, defaults work) ----
VITE_APP_NAME=LiveCaps
VITE_DETECTION_CONFIDENCE=0.5
# Face match = minimum similarity 0..1 (higher = stricter). Starting value; then auto-tuned per camera.
VITE_FACE_MATCH_THRESHOLD=0.55
# Pet match = minimum cosine similarity (higher = stricter). Starting value; then auto-tuned per camera.
VITE_PET_MATCH_THRESHOLD=0.75
VITE_MIN_FACE_SIZE_PX=80

# Pin to the EXACT version in package.json so JS and WASM match
VITE_MEDIAPIPE_WASM_URL=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@1.2.3/wasm
VITE_MEDIAPIPE_OBJECT_MODEL_URL=https://storage.googleapis.com/mediapipe-models/object_detector/efficientdet_lite0/float16/1/efficientdet_lite0.tflite
VITE_MEDIAPIPE_EMBEDDER_MODEL_URL=https://storage.googleapis.com/mediapipe-models/image_embedder/mobilenet_v3_small/float32/1/mobilenet_v3_small.tflite

# Blank = the pinned CDN build (@vladmandic/human@3.3.6). Or copy the models into /public/models and set /models for offline use.
VITE_HUMAN_MODELS_PATH=

# ---- Place names (optional) ----
VITE_GEOCODER=nominatim        # nominatim | mapbox | none
# Use a PUBLIC Mapbox token (starts with pk.) and restrict it to your site URL in the Mapbox dashboard.
VITE_MAPBOX_TOKEN=

# ---- Cloud backup (optional) ----
VITE_SUPABASE_URL=
# The anon key is public by design. It is only safe if Row Level Security is enabled on every table.
VITE_SUPABASE_ANON_KEY=
